[sub_resource type="GDScript" id="GDScript_nrhr1"]
script/source = "extends CharacterBody3D

const WALK_SPEED = 5.0
const SPRINT_SPEED = 8.5
const JUMP_VELOCITY = 4.5

# --- Hurdle settings ---
const HURDLE_MIN_SPEED = 6.0          # must be moving at least this fast to trigger
const HURDLE_LOW_HEIGHT = 0.4         # ankle/knee check height
const HURDLE_HIGH_HEIGHT = 1.6        # head check height (roughly eye level)
const HURDLE_RAY_DISTANCE = 0.9       # how far ahead to check
const HURDLE_FORWARD_DISTANCE = 1.3   # how far the vault moves you forward
const HURDLE_ARC_HEIGHT = 1.0         # peak height of the vault arc
const HURDLE_DURATION = 0.32          # seconds the vault animation takes
const HURDLE_COOLDOWN = 0.4           # prevents instant re-trigger after landing

var sensitivity := 0.003
var gravity: float = ProjectSettings.get_setting(\"physics/3d/default_gravity\")

var is_hurdling := false
var hurdle_cooldown_timer := 0.0

@onready var neck := $Neck
@onready var camera := $Neck/Camera3D


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	elif event.is_action_pressed(\"ui_cancel\"):
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)

	if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		if event is InputEventMouseMotion:
			neck.rotate_y(-event.relative.x * sensitivity)
			camera.rotate_x(-event.relative.y * sensitivity)
			camera.rotation.x = clamp(camera.rotation.x, deg_to_rad(-30), deg_to_rad(60))


func _physics_process(delta: float) -> void:
	if hurdle_cooldown_timer > 0.0:
		hurdle_cooldown_timer -= delta

	if is_hurdling:
		return # position is fully controlled by the tween while hurdling

	if not is_on_floor():
		velocity.y -= gravity * delta

	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	var current_speed = WALK_SPEED
	if Input.is_key_pressed(KEY_SHIFT):
		current_speed = SPRINT_SPEED

	var input_dir := Input.get_vector(\"left\", \"right\", \"forward\", \"back\")
	var direction: Vector3 = (neck.transform.basis * Vector3(input_dir.x, 0.0, input_dir.y)).normalized()

	if direction:
		velocity.x = direction.x * current_speed
		velocity.z = direction.z * current_speed
	else:
		velocity.x = move_toward(velocity.x, 0.0, current_speed)
		velocity.z = move_toward(velocity.z, 0.0, current_speed)

	# --- Hurdle check ---
	if is_on_floor() and hurdle_cooldown_timer <= 0.0 and direction.length() > 0.1:
		var horizontal_speed = Vector2(velocity.x, velocity.z).length()
		if horizontal_speed >= HURDLE_MIN_SPEED:
			try_start_hurdle(direction)

	move_and_slide()


func try_start_hurdle(direction: Vector3) -> void:
	var space_state := get_world_3d().direct_space_state

	var low_from := global_position + Vector3.UP * HURDLE_LOW_HEIGHT
	var low_to := low_from + direction * HURDLE_RAY_DISTANCE
	var high_from := global_position + Vector3.UP * HURDLE_HIGH_HEIGHT
	var high_to := high_from + direction * HURDLE_RAY_DISTANCE

	var low_query := PhysicsRayQueryParameters3D.create(low_from, low_to)
	var high_query := PhysicsRayQueryParameters3D.create(high_from, high_to)
	low_query.exclude = [self]
	high_query.exclude = [self]

	var low_result := space_state.intersect_ray(low_query)
	var high_result := space_state.intersect_ray(high_query)

	# Low ray hit something, high ray is clear -> it's hurdle-able
	if not low_result.is_empty() and high_result.is_empty():
		# Optional: only allow hurdling objects tagged in a group.
		# if not low_result.collider.is_in_group(\"Hurdleable\"):
		#     return
		start_hurdle(direction)


func start_hurdle(direction: Vector3) -> void:
	is_hurdling = true
	velocity = Vector3.ZERO

	var start_pos := global_position
	var end_pos := start_pos + direction * HURDLE_FORWARD_DISTANCE
	var peak_pos := start_pos + direction * (HURDLE_FORWARD_DISTANCE * 0.5) + Vector3.UP * HURDLE_ARC_HEIGHT

	var tween := create_tween()
	tween.set_trans(Tween.TRANS_SINE)
	tween.set_ease(Tween.EASE_OUT)
	tween.tween_method(
		func(t): _update_hurdle_position(t, start_pos, peak_pos, end_pos),
		0.0, 1.0, HURDLE_DURATION
	)
	tween.finished.connect(_on_hurdle_finished)


func _update_hurdle_position(t: float, start_pos: Vector3, peak_pos: Vector3, end_pos: Vector3) -> void:
	# quadratic Bezier for a smooth arc over the obstacle
	var a := start_pos.lerp(peak_pos, t)
	var b := peak_pos.lerp(end_pos, t)
	global_position = a.lerp(b, t)


func _on_hurdle_finished() -> void:
	is_hurdling = false
	hurdle_cooldown_timer = HURDLE_COOLDOWN
"

